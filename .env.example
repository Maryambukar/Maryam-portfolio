# Copy this file to .env and fill in real values. Never commit .env.
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (leave blank to use local sqlite for dev)
DATABASE_URL=sqlite:///db.sqlite3

# The ONLY username allowed to authenticate through the secured admin gate.
SITE_ADMIN_USERNAME=maryam

# Email (used by the Contact page to send messages straight to your inbox)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
CONTACT_RECEIVING_EMAIL=your-gmail-address@gmail.com
